+        adopt_inner_size(&windows, 1, |_| None::<()>, |()| unreachable!("no handle"));
+        adopt_inner_size(&windows, 9, |_| Some(()), |()| unreachable!("no window"));
+        assert_eq!(windows.borrow().get(&1).expect("window").size, (800, 600));
