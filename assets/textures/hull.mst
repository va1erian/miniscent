miniscent-recipe 1
size 256 256
gloss 120
# Spaceship hull: staggered plates and a band of smaller ones, rivet lines
# under the seams, an access hatch with its number, streaks and scorching.
op 0 0 1 bricks rows=4 cols=2 offset=0.5 mortar=0.04 seed=301 mode=mask
op 0 1 1 store name=big
op 0 2 1 bricks rows=8 cols=8 offset=0 mortar=0.05 seed=302 mode=mask
op 0 3 1 store name=small
op 0 5 1 rect x=0.5 y=0.625 w=1 h=0.25
op 0 6 1 store name=strip
op 0 7 1 load name=big
op 1 7 1 load name=small
op 2 7 1 load name=strip
op 0 8 3 mask
op 0 9 1 store name=plates
op 0 10 1 bricks rows=4 cols=2 offset=0.5 mortar=0.04 seed=301 mode=tint
op 0 11 1 range out_low=0.9
op 0 12 1 store name=tone
op 0 14 1 dots count_x=32 count_y=4 radius=0.0055 softness=0.005
op 0 15 1 rotozoom shift_y=0.91
op 0 16 1 store name=rivets
# The hatch: a groove round a slightly sunk door, its number, a stripe.
op 0 18 1 rect x=0.27 y=0.36 w=0.24 h=0.17
op 0 19 1 store name=door_o
op 0 21 1 rect x=0.27 y=0.36 w=0.22 h=0.15
op 0 22 1 store name=door_i
op 0 23 1 load name=door_o
op 1 23 1 load name=door_i
op 0 24 2 merge mode=subtract
op 0 25 1 store name=groove
op 0 26 1 stripes cycles_x=32 cycles_y=32 duty=0.5 color0=0.1,0.1,0.1 color1=0.86,0.62,0.08
op 0 27 1 store name=hazard
op 0 29 1 rect x=0.27 y=0.425 w=0.2 h=0.02
op 0 30 1 store name=haz_at
op 0 32 1 text text=07 x=0.2 y=0.31 scale=0.012 color=0.75,0.3,0.05
op 0 33 1 store name=marks
op 0 34 1 load name=marks
op 0 35 1 range in_high=0.05
op 0 36 1 store name=mark_m
op 0 38 1 text text=NO-STEP x=0.66 y=0.08 scale=0.0045
op 0 39 1 store name=label
# Height: plates level, seams and the groove cut, rivets on top.
op 0 40 1 load name=plates
op 1 40 1 load name=groove
op 0 41 2 merge mode=subtract
op 0 42 1 range out_low=0.2 out_high=0.75
op 0 43 1 store name=seamed
op 0 44 1 load name=door_i
op 0 45 1 range out_low=1 out_high=0.97
op 0 46 1 store name=door_h
op 0 47 1 load name=rivets
op 0 48 1 range out_high=0.15
op 0 49 1 store name=knobs
op 0 50 1 load name=seamed
op 1 50 1 load name=door_h
op 0 51 2 merge mode=multiply
op 0 52 1 store name=h0
op 0 53 1 load name=h0
op 1 53 1 load name=knobs
op 0 54 2 merge mode=add
op 0 55 1 blur radius=0.0012
op 0 56 1 store name=height
op 0 57 1 load name=height
op 0 58 1 out-height normal_strength=5
# Paint: pale grey per plate, the stripe and the number on the door.
op 0 59 1 noise freq_x=16 freq_y=16 octaves=3 persistence=0.5 seed=303 color0=0.56,0.58,0.6 color1=0.66,0.68,0.7
op 0 60 1 store name=paint
op 0 61 1 load name=paint
op 1 61 1 load name=tone
op 0 62 2 merge mode=multiply
op 0 63 1 store name=toned
op 0 64 1 load name=toned
op 1 64 1 load name=hazard
op 2 64 1 load name=haz_at
op 0 65 3 mask
op 0 66 1 store name=striped
op 0 67 1 load name=striped
op 1 67 1 load name=marks
op 2 67 1 load name=mark_m
op 0 68 3 mask
op 0 69 1 store name=numbered
op 0 70 1 load name=label
op 1 70 1 load name=numbered
op 0 71 2 merge mode=max
op 0 72 1 store name=lettered
# Weather: dark streaks running aft, soot near the seams, scorches.
op 0 73 1 noise freq_x=2 freq_y=48 octaves=1 persistence=0.5 seed=304
op 0 74 1 range in_low=0.5 out_low=1 out_high=0.78
op 0 75 1 store name=streak
op 0 76 1 noise freq_x=3 freq_y=3 octaves=5 persistence=0.6 seed=305
op 0 77 1 range in_low=0.66 in_high=0.9 out_low=1 out_high=0.6
op 0 78 1 color gain=1,0.95,0.88
op 0 79 1 store name=burn
op 0 80 1 load name=height
op 0 81 1 cavity radius=0.008 amount=2.5
op 0 82 1 store name=soot
op 0 83 1 load name=lettered
op 1 83 1 load name=streak
op 2 83 1 load name=burn
op 3 83 1 load name=soot
op 0 84 4 merge mode=multiply
op 0 85 1 store name=albedo
op 0 86 1 load name=albedo
op 0 87 1 out-albedo
op 0 88 1 load name=burn
op 1 88 1 load name=soot
op 0 89 2 merge mode=multiply
op 0 90 1 range out_low=0.1 out_high=0.8
op 0 91 1 store name=shine
op 0 92 1 load name=shine
op 0 93 1 out-specular
