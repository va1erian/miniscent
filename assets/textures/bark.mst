miniscent-recipe 1
size 128 128
gloss 8
# Dark furrows running up the trunk, with ridges broken into plates.
op 0 0 1 noise freq_x=5 freq_y=3 octaves=4 persistence=0.6 seed=71
op 0 1 1 range in_low=0.38 in_high=0.62
op 1 0 1 cells count=30 seed=72 mode=edge
op 1 1 1 range out_low=0.6
op 0 2 2 merge mode=multiply
op 0 3 1 store name=height
op 0 4 1 out-height normal_strength=5
# Colour follows height, with some mottling.
op 0 5 1 flat color=0.16,0.1,0.06
op 1 5 1 flat color=0.66,0.47,0.29
op 2 5 1 load name=height
op 0 6 3 mask
op 3 6 1 noise freq_x=8 freq_y=8 octaves=4 persistence=0.55 seed=73 color0=0.8,0.8,0.8 color1=1,1,1
op 0 7 4 merge mode=multiply
op 0 8 1 out-albedo
