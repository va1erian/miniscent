miniscent-recipe 1
size 256 256
gloss 110
# Living membrane: pink-red flesh, translucent where thin, a tree of dark
# veins over it and pale nodules pushing through.
op 0 0 1 noise freq_x=3 freq_y=3 octaves=4 persistence=0.5 seed=411 color1=1,0,0
op 0 1 1 store name=flow_u
op 0 2 1 noise freq_x=3 freq_y=3 octaves=4 persistence=0.5 seed=412 color1=0,1,0
op 0 3 1 store name=flow_v
op 0 4 1 load name=flow_u
op 1 4 1 load name=flow_v
op 0 5 2 merge mode=add
op 0 6 1 store name=flow
op 0 7 1 noise freq_x=3 freq_y=3 octaves=5 persistence=0.55 seed=413 mode=ridged
op 0 8 1 range in_low=0.72 in_high=0.9
op 0 9 1 store name=vein_big
op 0 10 1 noise freq_x=8 freq_y=8 octaves=4 persistence=0.55 seed=414 mode=ridged
op 0 11 1 range in_low=0.78 in_high=0.92 out_high=0.7
op 0 12 1 store name=vein_fine
op 0 13 1 load name=vein_big
op 1 13 1 load name=vein_fine
op 0 14 2 merge mode=max
op 0 15 1 store name=veins_raw
op 0 16 1 load name=veins_raw
op 1 16 1 load name=flow
op 0 17 2 distort amount=0.04
op 0 18 1 blur radius=0.002
op 0 19 1 store name=veins
op 0 21 1 dots count_x=5 count_y=5 radius=0.04 softness=0.06 jitter=1 seed=415
op 0 22 1 store name=nodule
op 0 23 1 cells count=16 seed=416 mode=distance
op 0 24 1 range in_low=0.05 in_high=0.45
op 0 25 1 range gamma=2
op 0 26 1 store name=thin
op 0 27 1 noise freq_x=16 freq_y=16 octaves=3 persistence=0.5 seed=417
op 0 28 1 store name=wrinkle
# Height: soft folds, veins standing up, nodules.
op 0 29 1 load name=thin
op 1 29 1 load name=wrinkle
op 0 30 2 merge mode=multiply
op 0 31 1 range out_high=0.4
op 0 32 1 store name=folds
op 0 33 1 load name=veins
op 0 34 1 range out_high=0.3
op 0 35 1 store name=v_h
op 0 36 1 load name=nodule
op 0 37 1 range out_high=0.35
op 0 38 1 range gamma=2
op 0 39 1 store name=n_h
op 0 40 1 load name=folds
op 1 40 1 load name=v_h
op 2 40 1 load name=n_h
op 0 41 3 merge mode=add
op 0 42 1 store name=height
op 0 43 1 load name=height
op 0 44 1 out-height normal_strength=5
# Colour: deep flesh where thick, rosy and pale where thin.
op 0 45 1 noise freq_x=6 freq_y=6 octaves=4 seed=418 color0=0.5,0.13,0.13 color1=0.66,0.22,0.2
op 0 46 1 store name=deep
op 0 47 1 flat color=0.86,0.48,0.42
op 0 48 1 store name=pale
op 0 49 1 load name=deep
op 1 49 1 load name=pale
op 2 49 1 load name=thin
op 0 50 3 mask
op 0 51 1 store name=flesh
op 0 52 1 flat color=0.3,0.06,0.24
op 0 53 1 store name=vein_c
op 0 54 1 load name=flesh
op 1 54 1 load name=vein_c
op 2 54 1 load name=veins
op 0 55 3 mask
op 0 56 1 store name=veined
op 0 57 1 flat color=0.9,0.74,0.55
op 0 58 1 store name=nod_c
op 0 59 1 load name=veined
op 1 59 1 load name=nod_c
op 2 59 1 load name=nodule
op 0 60 3 mask
op 0 61 1 store name=albedo
op 0 62 1 load name=albedo
op 0 63 1 out-albedo
op 0 64 1 load name=wrinkle
op 0 65 1 range out_low=0.5
op 0 66 1 store name=shine
op 0 67 1 load name=shine
op 0 68 1 out-specular
