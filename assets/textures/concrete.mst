miniscent-recipe 1
size 256 256
gloss 12
# Board-formed concrete: the grain of the planks printed in it, a seam per
# board, form-tie holes, bug holes, a hairline crack and rain stains.
op 0 0 1 stripes cycles_x=0 cycles_y=4 duty=0.985
op 0 1 1 store name=boards
op 0 2 1 noise freq_x=1 freq_y=40 octaves=1 persistence=0.5 seed=231
op 0 3 1 store name=woodgrain
op 0 4 1 noise freq_x=4 freq_y=4 octaves=5 persistence=0.55 seed=232
op 0 5 1 range out_high=0.65
op 0 6 1 store name=mottle
op 0 7 1 bricks rows=4 cols=1 offset=0 mortar=0 seed=238 mode=tint
op 0 8 1 range out_high=0.35
op 0 9 1 store name=board
op 0 10 1 load name=mottle
op 1 10 1 load name=board
op 0 11 2 merge mode=add
op 0 12 1 store name=tone
op 0 14 1 dots count_x=2 count_y=2 radius=0.012 softness=0.012
op 0 15 1 rotozoom shift_y=0.125
op 0 16 1 store name=ties
op 0 18 1 dots count_x=40 count_y=40 radius=0.0035 softness=0.003 jitter=1 seed=233
op 0 19 1 store name=bug
op 0 20 1 noise freq_x=8 freq_y=8 octaves=2 seed=234
op 0 21 1 range in_low=0.5 in_high=0.6
op 0 22 1 store name=bugmask
op 0 23 1 load name=bug
op 1 23 1 load name=bugmask
op 0 24 2 merge mode=multiply
op 0 25 1 store name=bugs
op 0 26 1 noise freq_x=3 freq_y=3 octaves=5 persistence=0.55 seed=235 mode=ridged
op 0 27 1 range in_low=0.9 in_high=0.97
op 0 28 1 store name=crack
op 0 29 1 noise freq_x=20 freq_y=1 octaves=2 persistence=0.5 seed=236
op 0 30 1 range in_low=0.45 out_low=1 out_high=0.7
op 0 31 1 store name=rain
# Height: boards and their grain, holes and the crack cut in.
op 0 32 1 load name=woodgrain
op 0 33 1 range out_low=0.6 out_high=0.68
op 0 34 1 store name=relief
op 0 35 1 load name=boards
op 0 36 1 range out_low=0.8
op 0 37 1 store name=seams
op 0 38 1 load name=ties
op 1 38 1 load name=bugs
op 2 38 1 load name=crack
op 0 39 3 merge mode=max
op 0 40 1 invert
op 0 41 1 store name=holes
op 0 42 1 load name=relief
op 1 42 1 load name=seams
op 2 42 1 load name=holes
op 0 43 3 merge mode=multiply
op 0 44 1 store name=height
op 0 45 1 load name=height
op 0 46 1 out-height normal_strength=5
# Colour: grey cement with aggregate speckle, darker in holes and stains.
op 0 47 1 load name=tone
op 0 48 1 range out_low=0.4 out_high=0.62
op 0 49 1 color gain=1,0.98,0.95
op 0 50 1 store name=cement
op 0 51 1 noise freq_x=64 freq_y=64 octaves=1 seed=237
op 0 52 1 range out_low=0.8
op 0 53 1 color amount=1.08
op 0 54 1 store name=grit
op 0 55 1 load name=height
op 0 56 1 cavity radius=0.01 amount=5
op 0 57 1 store name=crevice
op 0 58 1 load name=cement
op 1 58 1 load name=grit
op 2 58 1 load name=rain
op 3 58 1 load name=crevice
op 0 59 4 merge mode=multiply
op 0 60 1 store name=albedo
op 0 61 1 load name=albedo
op 0 62 1 out-albedo
op 0 63 1 load name=crevice
op 0 64 1 range out_low=0 out_high=0.3
op 0 65 1 store name=shine
op 0 66 1 load name=shine
op 0 67 1 out-specular
