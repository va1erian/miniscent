miniscent-recipe 1
size 256 256
gloss 60
# Alien monolith: polished black basalt cut with columns of glyphs, the cuts
# inlaid with a teal light, and a raised band at top and bottom.
# Glyphs: rows of capitals and signs, turned on end so they read as columns.
# Glyphs: two lines of signs laid half a sign apart merge into shapes no
# alphabet has; the rows are then turned on end into columns.
op 0 0 1 text text=H+I=X/T(O)L= x=0.02 y=0.08 scale=0.014
op 0 1 1 text text=Y=OI+T/HXL( x=0.02 y=0.27 scale=0.014
op 0 2 1 text text=(VI=T+O/LH x=0.02 y=0.46 scale=0.014
op 0 3 1 text text=TX=)O+I/YH x=0.02 y=0.65 scale=0.014
op 0 4 1 text text=O+/HX=IT(L x=0.02 y=0.84 scale=0.014
op 0 5 1 store name=rows_a
op 0 7 1 text text=YO=+LT)/HI(X x=0.062 y=0.108 scale=0.014
op 0 8 1 text text=T(X+=IO/L)H x=0.062 y=0.298 scale=0.014
op 0 9 1 text text==H/YO+XT(IL x=0.062 y=0.488 scale=0.014
op 0 10 1 text text=I(=LH+O/TX) x=0.062 y=0.678 scale=0.014
op 0 11 1 text text=L)=X+Y/IOHT x=0.062 y=0.868 scale=0.014
op 0 12 1 store name=rows_b
op 0 13 1 load name=rows_a
op 1 13 1 load name=rows_b
op 0 14 2 merge mode=max
op 0 15 1 store name=rows
op 0 16 1 load name=rows
op 0 17 1 rotozoom turns=1
op 0 18 1 store name=glyphs
op 0 20 1 rect x=0.5 y=0 w=1 h=0.07
op 0 21 1 store name=band
op 0 22 1 stripes cycles_x=5 cycles_y=0 duty=0.012
op 0 23 1 store name=rules
op 0 24 1 load name=rules
op 1 24 1 load name=band
op 0 25 2 merge mode=max
op 0 26 1 store name=rule
op 0 27 1 load name=glyphs
op 1 27 1 load name=rule
op 0 28 2 merge mode=max
op 0 29 1 store name=cut
# Height: stone face, cuts sunk with a rounded floor, bands raised.
op 0 30 1 noise freq_x=4 freq_y=4 octaves=5 persistence=0.5 seed=421
op 0 31 1 range out_low=0.55 out_high=0.62
op 0 32 1 store name=stone
op 0 33 1 load name=glyphs
op 0 34 1 blur radius=0.003
op 0 35 1 range in_high=0.6
op 0 36 1 invert
op 0 37 1 range out_low=0.25
op 0 38 1 store name=groove
op 0 39 1 load name=band
op 0 40 1 range out_low=1 out_high=0.85
op 0 41 1 invert
op 0 42 1 range out_high=0.2
op 0 43 1 store name=raised
op 0 44 1 load name=stone
op 1 44 1 load name=groove
op 0 45 2 merge mode=multiply
op 0 46 1 store name=h0
op 0 47 1 load name=h0
op 1 47 1 load name=raised
op 0 48 2 merge mode=add
op 0 49 1 store name=height
op 0 50 1 load name=height
op 0 51 1 out-height normal_strength=6
# Colour: basalt with violet glints, grain, and the light in the cuts.
op 0 52 1 noise freq_x=8 freq_y=8 octaves=4 persistence=0.6 seed=422 color0=0.035,0.035,0.045 color1=0.13,0.12,0.16
op 0 53 1 store name=basalt
op 0 55 1 dots count_x=48 count_y=48 radius=0.002 softness=0.002 jitter=1 seed=423
op 0 56 1 range out_high=0.5
op 0 57 1 store name=fleck
op 0 58 1 flat color=0.5,0.42,0.66
op 0 59 1 store name=glint
op 0 60 1 load name=basalt
op 1 60 1 load name=glint
op 2 60 1 load name=fleck
op 0 61 3 mask
op 0 62 1 store name=rock
op 0 63 1 glow x=0.5 y=0.5 radius=0.7 power=2 inner=0.35,1,0.9 outer=0.1,0.62,0.6
op 0 64 1 store name=light
op 0 65 1 load name=rock
op 1 65 1 load name=light
op 2 65 1 load name=cut
op 0 66 3 mask
op 0 67 1 store name=inlay
op 0 68 1 load name=band
op 0 69 1 blur radius=0.004
op 0 70 1 range in_low=0.2 in_high=0.5 out_low=1 out_high=0.6
op 0 71 1 store name=edge
op 0 72 1 load name=inlay
op 1 72 1 load name=edge
op 0 73 2 merge mode=multiply
op 0 74 1 store name=albedo
op 0 75 1 load name=albedo
op 0 76 1 out-albedo
op 0 77 1 load name=cut
op 0 78 1 invert
op 0 79 1 range out_low=0.1 out_high=0.85
op 0 80 1 store name=shine
op 0 81 1 load name=shine
op 0 82 1 out-specular
