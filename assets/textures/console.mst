miniscent-recipe 1
size 256 256
gloss 100
# A ship's console: a status screen and a scope behind bezels, a bank of lit
# keys, a vent grille and screws, on a dark powder-coated panel.
op 0 0 1 rect x=0.3 y=0.3 w=0.48 h=0.36
op 0 1 1 store name=screen_a
op 0 3 1 rect x=0.3 y=0.3 w=0.54 h=0.42 softness=0.01
op 0 4 1 store name=bezel_a
op 0 6 1 ellipse x=0.78 y=0.3 w=0.3 h=0.3
op 0 7 1 store name=screen_b
op 0 9 1 ellipse x=0.78 y=0.3 w=0.36 h=0.36 softness=0.01
op 0 10 1 store name=bezel_b
op 0 12 1 rect x=0.5 y=0.76 w=0.9 h=0.2
op 0 13 1 store name=bank
op 0 15 1 rect x=0.5 y=0.5 w=0.66 h=0.6 softness=0.03
op 0 16 1 rotozoom zoom_x=16 zoom_y=10
op 0 17 1 store name=key_grid
op 0 18 1 load name=key_grid
op 1 18 1 load name=bank
op 0 19 2 merge mode=multiply
op 0 20 1 store name=keys
op 0 22 1 rect x=0.5 y=0.955 w=0.9 h=0.05
op 0 23 1 store name=vent_at
op 0 24 1 stripes cycles_x=64 cycles_y=0 duty=0.5
op 0 25 1 store name=slots
op 0 26 1 load name=slots
op 1 26 1 load name=vent_at
op 0 27 2 merge mode=multiply
op 0 28 1 store name=vent
op 0 30 1 dots count_x=2 count_y=2 radius=0.008 softness=0.006
op 0 31 1 rotozoom shift_x=0.47 shift_y=0.47
op 0 32 1 store name=screws
# Height: panel, bezels raised, glass sunk, keys standing, slots cut.
op 0 33 1 load name=bezel_a
op 1 33 1 load name=bezel_b
op 0 34 2 merge mode=max
op 0 35 1 store name=bezels
op 0 36 1 load name=screen_a
op 1 36 1 load name=screen_b
op 0 37 2 merge mode=max
op 0 38 1 store name=glass
op 0 39 1 load name=bezels
op 0 40 1 range out_low=0.5 out_high=0.75
op 0 41 1 store name=b_h
op 0 42 1 load name=glass
op 0 43 1 range out_low=1 out_high=0.75
op 0 44 1 store name=g_h
op 0 45 1 load name=keys
op 0 46 1 range out_high=0.2
op 0 47 1 store name=k_h
op 0 48 1 load name=vent
op 0 49 1 range out_low=1 out_high=0.6
op 0 50 1 store name=v_h
op 0 51 1 load name=screws
op 0 52 1 range out_high=0.1
op 0 53 1 store name=s_h
op 0 54 1 load name=b_h
op 1 54 1 load name=g_h
op 2 54 1 load name=v_h
op 0 55 3 merge mode=multiply
op 0 56 1 store name=h0
op 0 57 1 load name=h0
op 1 57 1 load name=k_h
op 2 57 1 load name=s_h
op 0 58 3 merge mode=add
op 0 59 1 store name=height
op 0 60 1 load name=height
op 0 61 1 out-height normal_strength=5
# Status screen: green text over scan lines.
op 0 62 1 stripes cycles_x=0 cycles_y=64 duty=0.5 color0=0.02,0.1,0.06 color1=0.04,0.16,0.1
op 0 63 1 store name=scan
op 0 64 1 load name=scan
op 0 65 1 text text=SYS:NOMINAL x=0.09 y=0.15 scale=0.0055 color=0.4,1,0.55
op 0 66 1 text text=O2:98.2 x=0.09 y=0.21 scale=0.0055 color=0.4,1,0.55
op 0 67 1 text text=PWR:4.71GW x=0.09 y=0.27 scale=0.0055 color=0.4,1,0.55
op 0 68 1 text text=HULL:100 x=0.09 y=0.33 scale=0.0055 color=0.4,1,0.55
op 0 69 1 rect x=0.23 y=0.42 w=0.3 h=0.025 color=0.3,0.85,0.45
op 0 70 1 rect x=0.4 y=0.42 w=0.06 h=0.025 color=0.95,0.6,0.15
op 0 71 1 store name=readout
# Scope: amber rings and a sweep.
op 0 72 1 glow x=0.78 y=0.3 radius=0.15 power=0.5 inner=0.5,0.32,0.05 outer=0.06,0.03,0
op 0 73 1 ellipse x=0.78 y=0.3 w=0.2 h=0.2 color=0.4,0.24,0.04
op 0 74 1 ellipse x=0.78 y=0.3 w=0.19 h=0.19 color=0.12,0.06,0.01
op 0 75 1 ellipse x=0.78 y=0.3 w=0.1 h=0.1 color=0.4,0.24,0.04
op 0 76 1 ellipse x=0.78 y=0.3 w=0.09 h=0.09 color=0.18,0.09,0.01
op 0 77 1 line x0=0.78 y0=0.3 x1=0.86 y1=0.22 width=0.004 color=1,0.75,0.25
op 0 78 1 dots count_x=1 count_y=1 radius=0.006 softness=0.006 color=1,0.85,0.4
op 0 79 1 store name=scope
op 0 80 1 load name=readout
op 1 80 1 load name=scope
op 2 80 1 load name=screen_b
op 0 81 3 mask
op 0 82 1 store name=screens
# Keys: a lamp colour per key from a coarse cell pattern.
op 0 83 1 bricks rows=10 cols=16 offset=0 mortar=0 seed=311 mode=tint
op 0 84 1 store name=hue
op 0 85 1 flat color=0.9,0.18,0.1
op 0 86 1 store name=red_amber
op 0 87 1 flat color=0.25,0.85,0.35
op 0 88 1 store name=green
op 0 89 1 load name=hue
op 0 90 1 range in_low=0.45 in_high=0.46
op 0 91 1 store name=pick
op 0 92 1 load name=red_amber
op 1 92 1 load name=green
op 2 92 1 load name=pick
op 0 93 3 mask
op 0 94 1 store name=lamp0
op 0 95 1 flat color=0.85,0.85,0.8
op 0 96 1 store name=white
op 0 97 1 load name=hue
op 0 98 1 range in_low=0.8 in_high=0.81
op 0 99 1 store name=pick2
op 0 100 1 load name=lamp0
op 1 100 1 load name=white
op 2 100 1 load name=pick2
op 0 101 3 mask
op 0 102 1 store name=lamp
op 0 103 1 noise freq_x=32 freq_y=32 octaves=2 seed=312 color0=0.07,0.075,0.085 color1=0.11,0.115,0.125
op 0 104 1 store name=panel
op 0 105 1 flat color=0.2,0.21,0.23
op 0 106 1 store name=rims
op 0 107 1 load name=panel
op 1 107 1 load name=rims
op 2 107 1 load name=bezels
op 0 108 3 mask
op 0 109 1 store name=framed
op 0 110 1 load name=framed
op 1 110 1 load name=screens
op 2 110 1 load name=glass
op 0 111 3 mask
op 0 112 1 store name=glassed
op 0 113 1 load name=glassed
op 1 113 1 load name=lamp
op 2 113 1 load name=keys
op 0 114 3 mask
op 0 115 1 store name=keyed
op 0 116 1 load name=vent
op 0 117 1 range out_low=1 out_high=0.3
op 0 118 1 store name=vented
op 0 119 1 load name=keyed
op 1 119 1 load name=vented
op 0 120 2 merge mode=multiply
op 0 121 1 store name=albedo
op 0 122 1 load name=albedo
op 0 123 1 out-albedo
op 0 124 1 load name=glass
op 1 124 1 load name=keys
op 0 125 2 merge mode=max
op 0 126 1 range out_low=0.25
op 0 127 1 store name=shine
op 0 128 1 load name=shine
op 0 129 1 out-specular
