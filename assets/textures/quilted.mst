miniscent-recipe 1
size 256 256
gloss 30
# Padded cabin wall: diamond quilting in cream vinyl, puffed between the
# stitched seams, a button at every crossing.
op 0 0 1 gradient cycles_x=4 cycles_y=4
op 0 1 1 store name=d1
op 0 2 1 gradient cycles_x=4 cycles_y=-4
op 0 3 1 store name=d2
# Pillows: the diamond pyramid blurred round, with the seams pinched back in.
op 0 4 1 load name=d1
op 1 4 1 load name=d2
op 0 5 2 merge mode=min
op 0 6 1 store name=pyramid
op 0 7 1 load name=pyramid
op 0 8 1 blur radius=0.03
op 0 9 1 range in_low=0.15 in_high=0.85 gamma=1.4
op 0 10 1 store name=puffed
op 0 11 1 load name=pyramid
op 0 12 1 range in_high=0.12 gamma=2
op 0 13 1 store name=pinch
op 0 14 1 load name=puffed
op 1 14 1 load name=pinch
op 0 15 2 merge mode=multiply
op 0 16 1 store name=pillow
op 0 17 1 stripes cycles_x=48 cycles_y=-48 duty=0.5
op 0 18 1 store name=stitch_a
op 0 19 1 stripes cycles_x=48 cycles_y=48 duty=0.5
op 0 20 1 store name=stitch_b
op 0 21 1 load name=d1
op 1 21 1 load name=d2
op 0 22 2 merge mode=min
op 0 23 1 range in_low=0.07 in_high=0.08
op 0 24 1 store name=near
op 0 25 1 load name=d1
op 1 25 1 load name=d2
op 0 26 2 merge mode=min
op 0 27 1 range in_low=0.1 in_high=0.11
op 0 28 1 invert
op 0 29 1 store name=band
op 0 30 1 load name=near
op 1 30 1 load name=band
op 0 31 2 merge mode=multiply
op 0 32 1 store name=stitch_on
op 0 33 1 load name=stitch_a
op 1 33 1 load name=stitch_b
op 2 33 1 load name=stitch_on
op 0 34 3 merge mode=multiply
op 0 35 1 store name=stitches
op 0 37 1 dots count_x=4 count_y=4 radius=0.02 softness=0.014
op 0 38 1 store name=btn_a
op 0 39 1 load name=btn_a
op 0 40 1 rotozoom shift_x=0.125 shift_y=0.125
op 0 41 1 store name=btn_b
op 0 42 1 load name=btn_a
op 1 42 1 load name=btn_b
op 0 43 2 merge mode=max
op 0 44 1 store name=buttons
# Height: puffed diamonds, buttons and stitches a little proud.
op 0 45 1 noise freq_x=48 freq_y=48 octaves=1 seed=321
op 0 46 1 range out_high=0.03
op 0 47 1 store name=grain
op 0 48 1 load name=pillow
op 0 49 1 range out_low=0.15 out_high=0.9
op 0 50 1 store name=puff
op 0 51 1 load name=buttons
op 0 52 1 range out_high=0.3 gamma=2
op 0 53 1 store name=knob
op 0 54 1 load name=stitches
op 0 55 1 range out_high=0.06
op 0 56 1 store name=st_h
op 0 57 1 load name=puff
op 1 57 1 load name=knob
op 2 57 1 load name=grain
op 3 57 1 load name=st_h
op 0 58 4 merge mode=add
op 0 59 1 store name=height
op 0 60 1 load name=height
op 0 61 1 out-height normal_strength=6
# Colour: cream vinyl, darker in the folds, thread and buttons a shade off.
op 0 62 1 noise freq_x=8 freq_y=8 octaves=4 seed=322 color0=0.62,0.58,0.5 color1=0.72,0.68,0.6
op 0 63 1 store name=vinyl
op 0 64 1 load name=pillow
op 0 65 1 range out_low=0.5
op 0 66 1 store name=fold
op 0 67 1 flat color=0.24,0.19,0.14
op 0 68 1 store name=button_c
op 0 69 1 flat color=0.34,0.3,0.24
op 0 70 1 store name=thread
op 0 71 1 load name=vinyl
op 1 71 1 load name=fold
op 0 72 2 merge mode=multiply
op 0 73 1 store name=c0
op 0 74 1 load name=c0
op 1 74 1 load name=thread
op 2 74 1 load name=stitches
op 0 75 3 mask
op 0 76 1 store name=c1
op 0 77 1 load name=c1
op 1 77 1 load name=button_c
op 2 77 1 load name=buttons
op 0 78 3 mask
op 0 79 1 store name=albedo
op 0 80 1 load name=albedo
op 0 81 1 out-albedo
op 0 82 1 load name=pillow
op 0 83 1 range out_low=0.2 out_high=0.7
op 0 84 1 store name=shine
op 0 85 1 load name=shine
op 0 86 1 out-specular
