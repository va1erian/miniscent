miniscent-recipe 1
size 256 256
gloss 70
# A run of four painted pipes along a dark wall, held by clamps, with a
# flanged joint, worn paint and stencilled labels.
op 0 0 1 gradient cycles_x=0 cycles_y=4
op 0 1 1 range in_low=0.12 gamma=2.4
op 0 2 1 store name=round
op 0 3 1 load name=round
op 0 4 1 range in_high=0.02
op 0 5 1 store name=on
op 0 6 1 stripes cycles_x=2 cycles_y=0 duty=0.065
op 0 7 1 rotozoom shift_x=0.2
op 0 8 1 store name=clamps
op 0 9 1 stripes cycles_x=1 cycles_y=0 duty=0.035
op 0 10 1 rotozoom shift_x=0.7
op 0 11 1 store name=flange
op 0 13 1 dots count_x=1 count_y=8 radius=0.008 softness=0.008
op 0 14 1 rotozoom shift_x=0.2
op 0 15 1 store name=bolts
# Height: the pipes' round, clamps and the flange standing proud.
op 0 16 1 load name=clamps
op 1 16 1 load name=flange
op 0 17 2 merge mode=max
op 0 18 1 range out_high=0.16
op 0 19 1 store name=bands
op 0 20 1 load name=bands
op 1 20 1 load name=on
op 0 21 2 merge mode=multiply
op 0 22 1 store name=collars
op 0 23 1 load name=bolts
op 1 23 1 load name=on
op 0 24 2 merge mode=multiply
op 0 25 1 range out_high=0.1
op 0 26 1 store name=stud
op 0 27 1 load name=round
op 0 28 1 range out_high=0.78
op 0 29 1 store name=tall
op 0 30 1 load name=tall
op 1 30 1 load name=collars
op 2 30 1 load name=stud
op 0 31 3 merge mode=add
op 0 32 1 store name=height
op 0 33 1 load name=height
op 0 34 1 out-height normal_strength=6
# Paint per pipe: oxide red, safety yellow, grey and green.
op 0 36 1 rect x=0.5 y=0.125 w=1 h=0.25 color=0.42,0.12,0.08
op 0 37 1 rect x=0.5 y=0.375 w=1 h=0.25 color=0.72,0.55,0.08
op 0 38 1 rect x=0.5 y=0.625 w=1 h=0.25 color=0.4,0.42,0.43
op 0 39 1 rect x=0.5 y=0.875 w=1 h=0.25 color=0.12,0.3,0.18
op 0 40 1 store name=paint
op 0 41 1 load name=paint
op 0 42 1 rect x=0.45 y=0.125 w=0.16 h=0.07 color=0.85,0.85,0.8
op 0 43 1 text text=STEAM x=0.38 y=0.112 scale=0.0045 color=0.05,0.05,0.05
op 0 44 1 rect x=0.45 y=0.625 w=0.16 h=0.07 color=0.85,0.85,0.8
op 0 45 1 text text=AIR x=0.405 y=0.612 scale=0.0045 color=0.05,0.05,0.05
op 0 46 1 store name=labels
op 0 47 1 noise freq_x=12 freq_y=12 octaves=3 persistence=0.6 seed=241
op 0 48 1 range in_low=0.66 in_high=0.7
op 0 49 1 store name=chips
op 0 50 1 noise freq_x=8 freq_y=32 octaves=2 seed=242 color0=0.3,0.3,0.3 color1=0.5,0.5,0.52
op 0 51 1 store name=steel
op 0 52 1 load name=labels
op 1 52 1 load name=steel
op 2 52 1 load name=chips
op 0 53 3 mask
op 0 54 1 store name=worn
op 0 55 1 load name=worn
op 1 55 1 load name=steel
op 2 55 1 load name=bands
op 0 56 3 mask
op 0 57 1 store name=hardware
op 0 58 1 noise freq_x=8 freq_y=8 octaves=4 seed=243 color0=0.05,0.05,0.055 color1=0.12,0.12,0.12
op 0 59 1 store name=wall
op 0 60 1 load name=wall
op 1 60 1 load name=hardware
op 2 60 1 load name=on
op 0 61 3 mask
op 0 62 1 store name=laid
op 0 63 1 load name=round
op 0 64 1 range out_low=0.35
op 0 65 1 range gamma=1.5
op 0 66 1 store name=shade
op 0 67 1 load name=laid
op 1 67 1 load name=shade
op 0 68 2 merge mode=multiply
op 0 69 1 store name=albedo
op 0 70 1 load name=albedo
op 0 71 1 out-albedo
op 0 72 1 load name=on
op 1 72 1 load name=chips
op 0 73 2 merge mode=subtract
op 0 74 1 range out_low=0.0 out_high=0.85
op 0 75 1 store name=shine
op 0 76 1 load name=shine
op 0 77 1 out-specular
