miniscent-recipe 1
size 128 128
gloss 10
# Height: two scales of noise, then ridges through them.
op 0 0 1 noise freq_x=4 freq_y=4 octaves=5 persistence=0.55 seed=11 color1=0.85,0.85,0.85
op 1 0 1 noise freq_x=16 freq_y=16 octaves=3 persistence=0.5 seed=12 color1=0.15,0.15,0.15
op 0 1 2 merge mode=add
op 0 2 1 range out_high=0.6
op 1 2 1 noise freq_x=4 freq_y=4 octaves=5 persistence=0.55 seed=13 mode=ridged color1=0.4,0.4,0.4
op 0 3 2 merge mode=add
op 0 4 1 store name=height
op 0 5 1 out-height normal_strength=7
# Colour follows height.
op 0 6 1 load name=height
op 0 7 1 range out_low=0.3 out_high=0.65
op 0 8 1 color gain=1,0.94,0.86
op 0 9 1 out-albedo
