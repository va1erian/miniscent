miniscent-recipe 1
size 256 256
gloss 80
# Ship's deck: four gunmetal plates with a grip of raised dots, bolted at
# the corners, parted by a channel with amber guide lamps in it.
op 0 0 1 bricks rows=2 cols=2 offset=0 mortar=0.05 mode=mask
op 0 1 1 store name=plates
op 0 3 1 rect x=0.5 y=0 w=1 h=0.012
op 0 4 1 store name=chan_x
op 0 6 1 rect x=0 y=0.5 w=0.012 h=1
op 0 7 1 store name=chan_y
op 0 8 1 stripes cycles_x=32 cycles_y=0 duty=0.4
op 0 9 1 store name=dash_x
op 0 10 1 stripes cycles_x=0 cycles_y=32 duty=0.4
op 0 11 1 store name=dash_y
op 0 12 1 load name=chan_x
op 1 12 1 load name=dash_x
op 0 13 2 merge mode=multiply
op 0 14 1 store name=lamp_x
op 0 15 1 load name=chan_y
op 1 15 1 load name=dash_y
op 0 16 2 merge mode=multiply
op 0 17 1 store name=lamp_y
op 0 18 1 load name=lamp_x
op 1 18 1 load name=lamp_y
op 0 19 2 merge mode=max
op 0 20 1 store name=lamps
op 0 22 1 dots count_x=40 count_y=40 radius=0.0065 softness=0.005
op 0 23 1 store name=grip
op 0 25 1 dots count_x=2 count_y=2 radius=0.012 softness=0.008
op 0 26 1 store name=bolt
op 0 27 1 load name=bolt
op 0 28 1 rotozoom shift_x=0.38
op 0 29 1 store name=bolt_r
op 0 30 1 load name=bolt
op 1 30 1 load name=bolt_r
op 0 31 2 merge mode=max
op 0 32 1 store name=bolt_c
op 0 33 1 load name=bolt_c
op 0 34 1 rotozoom shift_y=0.38
op 0 35 1 store name=bolt_d
op 0 36 1 load name=bolt_c
op 1 36 1 load name=bolt_d
op 0 37 2 merge mode=max
op 0 38 1 rotozoom shift_x=0.31 shift_y=0.31
op 0 39 1 store name=bolts
# Height: plates, grip and bolts on them, the channel deep, lamps in it.
op 0 40 1 load name=plates
op 0 41 1 range out_low=0.0 out_high=0.75
op 0 42 1 store name=p_h
op 0 43 1 load name=grip
op 1 43 1 load name=plates
op 0 44 2 merge mode=multiply
op 0 45 1 range out_high=0.18
op 0 46 1 store name=on_plate
op 0 47 1 load name=bolts
op 0 48 1 range out_high=0.12
op 0 49 1 store name=b_h
op 0 50 1 load name=lamps
op 0 51 1 range out_high=0.15
op 0 52 1 store name=l_h
op 0 53 1 load name=p_h
op 1 53 1 load name=on_plate
op 2 53 1 load name=b_h
op 3 53 1 load name=l_h
op 0 54 4 merge mode=add
op 0 55 1 store name=height
op 0 56 1 load name=height
op 0 57 1 out-height normal_strength=6
# Colour: gunmetal, worn bright along a walking line, dark channel.
op 0 58 1 noise freq_x=12 freq_y=12 octaves=3 persistence=0.55 seed=341 color0=0.2,0.215,0.24 color1=0.3,0.315,0.34
op 0 59 1 store name=metal
op 0 60 1 gradient cycles_x=1 cycles_y=0
op 0 61 1 range in_low=0.6
op 0 62 1 store name=path
op 0 63 1 noise freq_x=24 freq_y=24 octaves=2 seed=342
op 0 64 1 store name=wear_n
op 0 65 1 load name=path
op 1 65 1 load name=wear_n
op 0 66 2 merge mode=multiply
op 0 67 1 range out_low=0.6
op 0 68 1 color amount=1.5
op 0 69 1 store name=wear
op 0 70 1 bricks rows=2 cols=2 offset=0 mortar=0 seed=343 mode=tint
op 0 71 1 range out_low=0.85
op 0 72 1 store name=plate_tone
op 0 73 1 load name=metal
op 1 73 1 load name=wear
op 2 73 1 load name=plate_tone
op 0 74 3 merge mode=multiply
op 0 75 1 store name=worn
op 0 76 1 load name=grip
op 0 77 1 range out_high=0.2
op 0 78 1 store name=grip_c
op 0 79 1 load name=worn
op 1 79 1 load name=grip_c
op 0 80 2 merge mode=add
op 0 81 1 store name=tops
op 0 82 1 flat color=0.03,0.03,0.035
op 0 83 1 store name=chan_c
op 0 84 1 load name=chan_c
op 1 84 1 load name=tops
op 2 84 1 load name=plates
op 0 85 3 mask
op 0 86 1 store name=laid
op 0 87 1 flat color=1,0.62,0.12
op 0 88 1 store name=amber
op 0 89 1 load name=laid
op 1 89 1 load name=amber
op 2 89 1 load name=lamps
op 0 90 3 mask
op 0 91 1 store name=lit
op 0 92 1 flat color=0.45,0.46,0.48
op 0 93 1 store name=bolt_col
op 0 94 1 load name=lit
op 1 94 1 load name=bolt_col
op 2 94 1 load name=bolts
op 0 95 3 mask
op 0 96 1 store name=albedo
op 0 97 1 load name=albedo
op 0 98 1 out-albedo
op 0 99 1 load name=plates
op 1 99 1 load name=wear
op 0 100 2 merge mode=multiply
op 0 101 1 store name=shine
op 0 102 1 load name=shine
op 0 103 1 out-specular
