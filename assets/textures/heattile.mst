miniscent-recipe 1
size 256 256
gloss 20
# Heat-shield tiles: black ceramic laid staggered, each a slightly different
# shade, a few pale replacements, felt in the gaps, scorched and chalky.
op 0 0 1 bricks rows=8 cols=8 offset=0.5 mortar=0.06 seed=331 mode=mask
op 0 1 1 store name=tiles
op 0 2 1 bricks rows=8 cols=8 offset=0.5 mortar=0.06 seed=331 mode=tint
op 0 3 1 store name=shade
op 0 4 1 bricks rows=8 cols=8 offset=0.5 mortar=0.06 bevel=0.07 seed=331 mode=bevel
op 0 5 1 store name=bevel
op 0 6 1 noise freq_x=64 freq_y=64 octaves=1 seed=332
op 0 7 1 store name=pore
# Height: rounded tile edges, a porous top, felt in the gap below.
op 0 8 1 load name=pore
op 0 9 1 range out_low=0.94
op 0 10 1 store name=top
op 0 11 1 load name=bevel
op 1 11 1 load name=top
op 0 12 2 merge mode=multiply
op 0 13 1 store name=height
op 0 14 1 load name=height
op 0 15 1 out-height normal_strength=6
# Colour: near-black tiles by shade, one in ten pale grey.
op 0 16 1 load name=shade
op 0 17 1 range out_low=0.06 out_high=0.17
op 0 18 1 color gain=1,0.98,0.96
op 0 19 1 store name=black
op 0 20 1 load name=shade
op 0 21 1 range in_low=0.93 in_high=0.935
op 0 22 1 store name=pale_at
op 0 23 1 noise freq_x=16 freq_y=16 octaves=3 seed=333 color0=0.5,0.5,0.48 color1=0.6,0.6,0.58
op 0 24 1 store name=pale
op 0 25 1 load name=black
op 1 25 1 load name=pale
op 2 25 1 load name=pale_at
op 0 26 3 mask
op 0 27 1 store name=ceramic
op 0 28 1 load name=pore
op 0 29 1 range out_low=0.8
op 0 30 1 color amount=1.1
op 0 31 1 store name=grit
op 0 32 1 load name=bevel
op 0 33 1 slope strength=3
op 0 34 1 range out_high=0.1
op 0 35 1 store name=chalk
op 0 36 1 noise freq_x=32 freq_y=32 octaves=2 seed=334 color0=0.42,0.4,0.36 color1=0.56,0.54,0.5
op 0 37 1 store name=felt
op 0 38 1 load name=ceramic
op 1 38 1 load name=grit
op 0 39 2 merge mode=multiply
op 0 40 1 store name=c0
op 0 41 1 load name=c0
op 1 41 1 load name=chalk
op 0 42 2 merge mode=add
op 0 43 1 store name=c1
op 0 44 1 load name=felt
op 1 44 1 load name=c1
op 2 44 1 load name=tiles
op 0 45 3 mask
op 0 46 1 store name=laid
op 0 47 1 noise freq_x=2 freq_y=4 octaves=5 persistence=0.6 seed=335
op 0 48 1 range in_low=0.55 in_high=0.8 out_low=1 out_high=0.55
op 0 49 1 color gain=1,0.9,0.8
op 0 50 1 store name=scorch
op 0 51 1 load name=laid
op 1 51 1 load name=scorch
op 0 52 2 merge mode=multiply
op 0 53 1 store name=albedo
op 0 54 1 load name=albedo
op 0 55 1 out-albedo
op 0 56 1 load name=pore
op 0 57 1 range out_low=0.15 out_high=0.45
op 0 58 1 store name=glaze
op 0 59 1 load name=tiles
op 1 59 1 load name=glaze
op 2 59 1 load name=scorch
op 0 60 3 merge mode=multiply
op 0 61 1 store name=shine
op 0 62 1 load name=shine
op 0 63 1 out-specular
